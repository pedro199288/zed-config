// Zed settings
//
// Shared across macOS, Linux, and Windows by setup-zed-symlinks.
{
  "proxy": "",
  "vim_mode": true,
  "edit_predictions": {
    "mode": "eager"
  },
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
    "dock": "left"
  },
  "diff_view_style": "unified",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "tabs": {
    "file_icons": true
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "zed.dev"
      ]
    },
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "search_web": { "default": "allow" },
        "fetch": {
          "default": "allow",
          "always_confirm": [
            { "pattern": "(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|\\[::1\\])" }
          ]
        },
        "skill": { "default": "allow" },
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^(pwd|ls|find|grep|rg|cat|bat|sed|awk|wc|sort|uniq|diff|cmp|file|stat|du|df|which|whereis|tree)\\b" },
            { "pattern": "^git\\s+(status|log|diff|show|branch|blame|rev-parse|ls-files|remote)(\\s|$)" },
            { "pattern": "^(npm|pnpm|yarn|bun)\\s+(test|run|build|lint|typecheck|check)(\\s|$)" },
            { "pattern": "^cargo\\s+(build|test|check|fmt|clippy)(\\s|$)" },
            { "pattern": "^go\\s+(build|test|vet|fmt)(\\s|$)" },
            { "pattern": "^(pytest|ruff|mypy|eslint|prettier|tsc)(\\s|$)" }
          ],
          "always_confirm": [
            { "pattern": "(^|[;&|]\\s*)sudo\\b" },
            { "pattern": "\\bgit\\s+(push|commit|merge|rebase|reset|clean|checkout|switch|restore|tag)(\\s|$)" },
            { "pattern": "\\b(npm|pnpm|yarn|bun)\\s+(publish|add|install|remove|uninstall|update|upgrade)(\\s|$)" },
            { "pattern": "\\b(curl|wget|ssh|scp|rsync|nc|ncat)\\b" },
            { "pattern": "\\b(rm|rmdir|mv|chmod|chown|kill|pkill|killall)\\b" }
          ],
          "always_deny": [
            { "pattern": "(^|[ /])\\.env([. /]|$)" },
            { "pattern": "(^|[ /])(secrets?|credentials?)([ /]|$)" },
            { "pattern": "\\.(pem|key|p12|pfx)(\\s|$)" },
            { "pattern": "\\brm\\s+[^;&|]*(--recursive|-[A-Za-z]*r[A-Za-z]*)[^;&|]*(/|~)(\\s|$)" }
          ]
        },
        "edit_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "(^|/)\\.env($|[./])" },
            { "pattern": "(^|/)(secrets?|credentials?)(/|$)" },
            { "pattern": "\\.(pem|key|p12|pfx)$" }
          ]
        },
        "write_file": {
          "default": "allow",
          "always_deny": [
            { "pattern": "(^|/)\\.env($|[./])" },
            { "pattern": "(^|/)(secrets?|credentials?)(/|$)" },
            { "pattern": "\\.(pem|key|p12|pfx)$" }
          ]
        },
        "create_directory": { "default": "allow" },
        "delete_path": { "default": "confirm" },
        "move_path": { "default": "confirm" },
        "copy_path": { "default": "confirm" }
      }
    },
    "show_turn_stats": true,
    "thinking_display": "always_collapsed",
    "single_file_review": true,
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "low"
    },
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "dock": "right",
    "play_sound_when_agent_done": "always",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": false
  },
  "terminal": {
    "font_size": 12.0,
    "max_scroll_history_lines": 10000
  },
  "node": {
    "npm_path": "pnpm"
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false
  },
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "sticky_scroll": {
    "enabled": false
  },
  "minimap": {
    "show": "never"
  },
  "cursor_shape": "bar",
  "cursor_blink": false,
  "colorize_brackets": true,
  "show_edit_predictions": true,
  "format_on_save": "on",
  "tab_size": 2,
  "agent_servers": {
    "cursor": {
      "default_config_options": {
        "mode": "agent"
      },
      "type": "registry"
    },
    "codex-acp": {
      "favorite_config_option_values": {
        "reasoning_effort": [
          "high"
        ]
      },
      "default_config_options": {
        "reasoning_effort": "high"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "model": "opus"
      },
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "angular": true,
    "html": true,
    "material-icon-theme": true,
    "nvim-nightfox": true,
    "scss": true,
    "vscode-2026-theme": true,
    "vscode-dark-modern": true,
    "vscode-dark-siri-custom": true,
    "vscode-modern": true
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "VSCode Dark Modern"
  }
}

