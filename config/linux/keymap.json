[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "j": "vim::Left",
      "k": "vim::Down",
      "l": "vim::Up",
      "ñ": "vim::Right"
    }
  },
  {
    "context": "not_editing",
    "bindings": {
      "j": ["workspace::SendKeystrokes", "left"],
      "k": ["workspace::SendKeystrokes", "down"],
      "l": ["workspace::SendKeystrokes", "up"],
      "ñ": ["workspace::SendKeystrokes", "right"]
    }
  },
  {
    "context": "VimControl && menu",
    "bindings": {
      "j": ["workspace::SendKeystrokes", "left"],
      "k": ["workspace::SendKeystrokes", "down"],
      "l": ["workspace::SendKeystrokes", "up"],
      "ñ": ["workspace::SendKeystrokes", "right"]
    }
  },
  {
